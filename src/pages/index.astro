---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Joel Nandorf"
  description="Joel Nandorf — tech lead i Umeå som jobbar med AI i produktion."
>
  <section class="measure py-16 md:py-24">
    <h1
      class="font-display text-[40px] md:text-[56px] leading-[1.1] tracking-tight text-ink mb-7"
    >
      Joel Nandorf
    </h1>

    <p class="text-ink-muted leading-relaxed mb-10 max-w-[55ch]">
      Tech lead i Umeå. Sitter i en produkttrio tillsammans med en UX-lead och
      en PM, och har drivit AI-arbete i produktion i över ett år — från idé till
      driftsatt system.
    </p>

    <p class="text-sm text-ink-muted">
      <a
        href="mailto:joel.nandorf@gmail.com"
        class="text-accent underline decoration-accent underline-offset-4"
        >joel.nandorf@gmail.com</a
      >
    </p>
  </section>
</BaseLayout>
