---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Shift+Build — bygga på gränsen mellan kod, produkt och design"
  description="Perspektiv från en tech lead i en produkttrio: AI-arkitektur i praktiken, tekniskt ledarskap utan mandat, och hur rollerna inom produktutveckling konvergerar."
>
  <section
    class="measure pb-11 md:pb-12 mb-8 md:mb-9 border-b border-outline-variant"
  >
    <h1
      class="font-display text-[40px] md:text-[64px] leading-[1.08] tracking-tight text-ink mb-7 md:mb-8 max-w-[13ch] md:max-w-[15ch]"
    >
      Perspektiv från någon som bygger på gränsen mellan kod, produkt och
      design.
    </h1>
    <div class="space-y-4">
      <p class="text-ink-muted leading-relaxed">
        Jag är tech lead, sitter i en produkttrio och jobbar med AI i
        produktion. Här skriver jag om vad jag faktiskt ser förändras —
        AI-arkitektur i praktiken, tekniskt ledarskap utan mandat, och hur
        gränsen mellan att koda, designa och äga en produkt blir tunnare för
        varje år.
      </p>
      <p class="text-ink-muted leading-relaxed">
        Inget om hur saker borde fungera i teorin. Bara hur de fungerar när man
        sitter mitt i det.
      </p>
    </div>
  </section>

  <section class="measure pb-16 md:pb-20">
    {
      posts.length === 0 ? (
        <p class="text-ink-muted py-8">
          Första inläggen är på väg. Kom tillbaka snart, eller följ via{' '}
          <a
            href={`${base}/rss.xml`}
            class="text-accent underline decoration-accent underline-offset-4"
          >
            RSS
          </a>{' '}
          så missar du inget.
        </p>
      ) : (
        <div>
          {posts.map((post, index) => (
            <div
              class={
                index > 0 ? 'pt-7 mt-7 border-t border-outline-variant' : ''
              }
            >
              <ArticleCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                slug={post.id.replace(/\.md$/, '')}
                tags={post.data.tags}
                topic={post.data.topic}
              />
            </div>
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
