---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { TOPICS, getTopicLabel } from '../../lib/topics';

export async function getStaticPaths() {
  return TOPICS.map((topic) => ({ params: { topic: topic.slug } }));
}

const { topic } = Astro.params;

const posts = (
  await getCollection('blog', ({ data }) => !data.draft && data.topic === topic)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const label = getTopicLabel(topic);
---

<BaseLayout
  title={`${label} — Shift+Build`}
  description={`Alla inlägg om ${label} på Shift+Build.`}
>
  <section
    class="measure pb-11 md:pb-12 mb-8 md:mb-9 border-b border-outline-variant"
  >
    <span
      class="block text-[11px] font-medium tracking-[0.08em] uppercase text-accent mb-4"
    >
      Ämne
    </span>
    <h1
      class="font-display text-[40px] md:text-[52px] leading-[1.1] tracking-tight text-ink"
    >
      {label}
    </h1>
  </section>

  <section class="measure pb-16 md:pb-20">
    {
      posts.length === 0 ? (
        <p class="text-ink-muted py-8">Inga inlägg om {label} än.</p>
      ) : (
        <div>
          {posts.map((post, index) => (
            <div
              class={
                index > 0 ? 'pt-7 mt-7 border-t border-outline-variant' : ''
              }
            >
              <ArticleCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                slug={post.id.replace(/\.md$/, '')}
                tags={post.data.tags}
                topic={post.data.topic}
              />
            </div>
          ))}
        </div>
      )
    }

    <div class="mt-12">
      <a
        href={`${base}/amnen`}
        class="text-sm text-ink-muted hover:text-ink transition-colors"
        >← Alla ämnen</a
      >
    </div>
  </section>
</BaseLayout>
