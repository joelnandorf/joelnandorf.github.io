---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { TOPICS } from '../../lib/topics';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const topicsWithCount = TOPICS.map((topic) => ({
  ...topic,
  count: posts.filter((post) => post.data.topic === topic.slug).length,
}));
---

<BaseLayout
  title="Ämnen — Shift+Build"
  description="Alla ämnen på Shift+Build — bläddra bland inläggen efter AI-arkitektur, tech lead och rollkonvergens."
>
  <section
    class="measure pb-11 md:pb-12 mb-8 md:mb-9 border-b border-outline-variant"
  >
    <h1
      class="font-display text-[40px] md:text-[52px] leading-[1.1] tracking-tight text-ink mb-5"
    >
      Ämnen
    </h1>
    <p class="text-ink-muted leading-relaxed">
      Bläddra bland inläggen efter ämne.
    </p>
  </section>

  <section class="measure pb-16 md:pb-20">
    {
      topicsWithCount.map((topic, index) => (
        <a
          href={`${base}/amnen/${topic.slug}`}
          class={`group flex items-center justify-between gap-4 no-underline py-5 ${
            index > 0 ? 'border-t border-outline-variant' : ''
          }`}
        >
          <span class="font-display text-2xl text-ink group-hover:text-accent transition-colors">
            {topic.label}
          </span>
          <span class="font-mono text-[11px] text-ink-muted shrink-0">
            {topic.count} inlägg
          </span>
        </a>
      ))
    }
  </section>
</BaseLayout>
