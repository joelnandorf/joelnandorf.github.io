---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { getTopicLabel } from '../lib/topics';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  topic: string;
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  relatedPosts?: CollectionEntry<'blog'>[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  topic,
  heroImage,
  heroImageAlt,
  relatedPosts = [],
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const dateOptions: Intl.DateTimeFormatOptions = {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
};
---

<BaseLayout
  title={`${title} — Shift+Build`}
  description={description}
  canonicalURL={canonicalURL}
  ogTitle={title}
  ogDescription={description}
>
  <article class="pb-16 md:pb-20">
    {
      heroImage && (
        <div class="measure mb-10 md:mb-12">
          <Image
            src={heroImage}
            alt={heroImageAlt ?? ''}
            class="w-full h-auto aspect-[3/2] object-cover dark:opacity-90"
            widths={[400, 800, 1200]}
            sizes="(min-width: 45rem) 736px, 100vw"
          />
        </div>
      )
    }

    <header class="measure mb-10 md:mb-12 pb-9 border-b border-outline-variant">
      <a
        href={`${base}/amnen/${topic}`}
        class="text-[11px] font-medium tracking-[0.08em] uppercase text-accent mb-4 block no-underline hover:underline"
      >
        {getTopicLabel(topic)}
      </a>

      <h1
        class="font-display text-[32px] md:text-[44px] leading-[1.15] tracking-tight text-ink mb-5"
      >
        {title}
      </h1>

      <p class="text-ink-muted text-lg leading-relaxed mb-5">
        {description}
      </p>

      <div class="flex flex-wrap items-center gap-2 text-sm text-ink-muted">
        <span>Joel Nandorf</span>
        <span class="text-outline-variant">·</span>
        <time datetime={pubDate.toISOString()} class="font-mono text-[13px]"
          >{pubDate.toLocaleDateString('sv-SE', dateOptions)}</time
        >
        {
          updatedDate && updatedDate > pubDate && (
            <Fragment>
              <span class="text-outline-variant">·</span>
              <span class="italic">
                Uppdaterad{' '}
                {updatedDate.toLocaleDateString('sv-SE', dateOptions)}
              </span>
            </Fragment>
          )
        }
      </div>
    </header>

    <div
      class="measure prose prose-lg max-w-none
      prose-headings:font-display prose-headings:text-ink prose-headings:font-normal prose-headings:tracking-tight
      prose-h2:text-2xl md:prose-h2:text-3xl prose-h2:mt-14 prose-h2:mb-5
      prose-h3:text-xl prose-h3:mt-10 prose-h3:mb-4
      prose-p:text-ink-muted prose-p:leading-relaxed
      prose-li:text-ink-muted
      prose-a:text-accent prose-a:underline prose-a:decoration-accent prose-a:decoration-1 prose-a:underline-offset-4 prose-a:font-normal hover:prose-a:decoration-2
      prose-strong:text-ink prose-strong:font-semibold
      prose-blockquote:font-display prose-blockquote:not-italic prose-blockquote:border-l-2 prose-blockquote:border-accent prose-blockquote:text-ink prose-blockquote:text-xl prose-blockquote:leading-snug prose-blockquote:py-1
      prose-code:font-mono prose-code:text-sm prose-code:text-ink prose-code:bg-surface-container-low prose-code:px-1.5 prose-code:py-0.5 prose-code:before:content-none prose-code:after:content-none
      prose-pre:bg-surface-container
      prose-hr:border-outline-variant"
    >
      <slot />
    </div>

    {
      tags.length > 0 && (
        <div class="measure mt-12 pt-6 border-t border-outline-variant flex flex-wrap gap-x-4 gap-y-2">
          {tags.map((tag) => (
            <span class="font-mono text-[11px] text-ink-muted">#{tag}</span>
          ))}
        </div>
      )
    }

    <div class="measure mt-10 py-8 border-t border-b border-outline-variant">
      <p class="text-sm mb-2">
        <strong class="font-display text-base">Joel Nandorf</strong> är tech lead
        i Umeå och skriver om AI-arkitektur, tekniskt ledarskap och hur rollerna inom
        produktutveckling konvergerar.
      </p>
      <p class="text-sm text-ink-muted">
        Gillade du det här? Följ via{' '}
        <a
          href={`${base}/rss.xml`}
          class="text-accent underline decoration-accent underline-offset-4"
          >RSS</a
        > eller hör av dig på{' '}
        <a
          href="https://www.linkedin.com/in/joelnandorf"
          rel="noopener noreferrer"
          target="_blank"
          class="text-accent underline decoration-accent underline-offset-4"
          >LinkedIn</a
        > — jag svarar gärna.
      </p>
    </div>

    <div class="measure mt-8">
      <a
        href={base || '/'}
        class="text-sm text-ink-muted hover:text-ink transition-colors"
        >← Alla inlägg</a
      >
    </div>
  </article>

  {
    relatedPosts.length > 0 && (
      <section class="measure pb-16 md:pb-20 pt-9 border-t border-outline-variant">
        <span class="block text-[11px] font-medium tracking-[0.08em] uppercase text-ink-muted mb-8">
          Läs vidare
        </span>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
          {relatedPosts.map((rp) => (
            <div class="group relative block">
              <a
                href={`${base}/amnen/${rp.data.topic}`}
                class="relative z-10 text-[11px] font-medium tracking-[0.08em] uppercase text-accent no-underline hover:underline"
              >
                {getTopicLabel(rp.data.topic)}
              </a>
              <h4 class="font-display text-xl text-ink mt-2 leading-snug group-hover:text-accent transition-colors">
                <a
                  href={`${base}/blog/${rp.id.replace(/\.md$/, '')}`}
                  class="no-underline text-inherit after:absolute after:inset-0"
                >
                  {rp.data.title}
                </a>
              </h4>
            </div>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
