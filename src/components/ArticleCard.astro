---
import { getTopicLabel } from '../lib/topics';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags: string[];
  topic: string;
}

const { title, description, pubDate, slug, topic } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const dateOptions: Intl.DateTimeFormatOptions = {
  day: 'numeric',
  month: 'short',
};
---

<article class="group relative">
  <div class="flex items-baseline gap-3 mb-3">
    <a
      href={`${base}/amnen/${topic}`}
      class="relative z-10 text-[11px] font-medium tracking-[0.08em] uppercase text-accent no-underline hover:underline"
    >
      {getTopicLabel(topic)}
    </a>
    <time
      datetime={pubDate.toISOString()}
      class="font-mono text-[11px] text-ink-muted"
    >
      {pubDate.toLocaleDateString('sv-SE', dateOptions)}
    </time>
  </div>

  <h2
    class="font-display text-[24px] md:text-[29px] leading-[1.15] text-ink mb-2 group-hover:text-accent transition-colors duration-300"
  >
    <a
      href={`${base}/blog/${slug}`}
      class="no-underline text-inherit after:absolute after:inset-0"
    >
      {title}
    </a>
  </h2>

  <p class="text-ink-muted text-[15.5px] leading-relaxed max-w-[60ch]">
    {description}
  </p>
</article>
